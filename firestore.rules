rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Workflows collection - users can only access their own workflows
    match /workflows/{workflowId} {
      // 읽기: 로그인한 사용자가 자신의 워크플로우만 읽을 수 있음
      allow read: if request.auth != null &&
        (resource == null || resource.data.userId == request.auth.uid);
      // 생성: 로그인한 사용자가 자신의 userId로만 생성 가능
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      // 수정/삭제: 로그인한 사용자가 자신의 워크플로우만 수정 가능
      allow update, delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // Executions collection - users can only access their own executions
    match /executions/{executionId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.triggeredBy;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.triggeredBy;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.triggeredBy;
    }

    // Tasks collection - users can only access their own tasks
    match /tasks/{taskId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Templates collection - public read, admin write
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false; // Admin only via Firebase console
    }

    // API Keys collection - only server can access
    match /apiKeys/{keyId} {
      allow read, write: if false; // Server-side only
    }
  }
}
